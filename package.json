{
  "name": "express",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "db:generate": "npx prisma generate --no-engine",
    "db:seed": "npx prisma db seed",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:migrate:fresh": "npx prisma migrate reset",
    "db:reset": "npx prisma migrate reset --skip-seed"
  },
  "dependencies": {
    "@prisma/client": "6.9.0",
    "@prisma/extension-accelerate": "2.0.2",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "5.1.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.15.32",
    "nodemon": "^3.1.10",
    "prisma": "6.9.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
